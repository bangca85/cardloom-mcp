KNOWLEDGE_STORE_PATH=./knowledge-store
INDEX_DB_PATH=./knowledge-store/.metadata/index.db
REVIEWER_NAME=human-reviewer
# Search (defaults shown). tiered: when exact-word search finds too few cards, add partial matches labelled
# "related". off: exact-word search only.
SEARCH_FALLBACK=tiered
# baseline | x | y. x and y also rank by project and are opt-in (see README, "How search works").
SEARCH_RANKING=baseline
# Web viewer graph view: edges between cards that share a stack tag
GRAPH_GENERIC_STACK_TAGS=
MAX_SHARED_STACK_GROUP_SIZE=50
MAX_SHARED_STACK_EDGES=5000
# Knowledge gaps (README, "Knowledge gaps"). OFF by default: nothing is recorded unless this is "local".
# local: append how each search ended (time, result count, answered/related_only/empty, ms) to telemetry.jsonl
# beside the index (mode 0600), never inside the knowledge store: with INDEX_DB_PATH unset the default would be
# inside it and nothing is recorded. Never card ids, results, context or repo names. Read it with `cardloom-mcp gaps`.
CARDLOOM_TELEMETRY=
# 1 or true: also record the text of searches that found no direct answer (200 chars, secret-scanned). The scan
# catches common credential formats only (case-sensitive) and does not remove customer names or internal terms;
# leave this off unless you want the text on disk.
CARDLOOM_TELEMETRY_SAMPLES=
# Optional absolute path of the telemetry file, instead of telemetry.jsonl beside the index. Refused inside the store.
CARDLOOM_TELEMETRY_PATH=
